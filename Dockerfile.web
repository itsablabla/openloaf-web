# OpenLoaf web-mode production image
# ────────────────────────────────────────────────────────────────
# Coolify's IPv6 to ghcr.io resets connections on large layers.
# Strategy: keep the image reasonable (~500-700 MB compressed) by
# aggressively pruning dev/build tooling and Electron before shipping.
# Chromium is still fetched on first-boot to keep the base slim.

FROM node:22-bookworm-slim AS deps

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 pkg-config git curl ca-certificates \
    ffmpeg libvips42 procps \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
ENV NODE_OPTIONS=--max-old-space-size=6144 \
    npm_config_network_concurrency=8 \
    npm_config_child_concurrency=4 \
    npm_config_fetch_retries=8 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_retry_mintimeout=10000 \
    PNPM_HOME=/pnpm \
    CI=1

WORKDIR /app
COPY . .

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked,id=pnpm-store-v2 \
    (pnpm install --no-frozen-lockfile --ignore-scripts --reporter=append-only \
     || (echo '=== retry 1 (concurrency=4) ===' && sleep 15 && \
         npm_config_network_concurrency=4 pnpm install --no-frozen-lockfile --ignore-scripts --reporter=append-only) \
     || (echo '=== retry 2 (concurrency=2) ===' && sleep 30 && \
         npm_config_network_concurrency=2 pnpm install --no-frozen-lockfile --ignore-scripts --reporter=append-only) \
     || (echo '=== retry 3 (concurrency=1) ===' && sleep 60 && \
         npm_config_network_concurrency=1 pnpm install --no-frozen-lockfile --ignore-scripts --reporter=append-only))

RUN for pkg in sharp better-sqlite3 node-pty @parcel/watcher esbuild @swc/core \
                prisma @prisma/engines @napi-rs/canvas; do \
      (cd node_modules/$pkg 2>/dev/null && npm rebuild 2>&1 | tail -2) || echo "skip $pkg"; \
    done

# ────────────────────────────────────────────────────────────────
FROM deps AS build

WORKDIR /app
RUN pnpm --filter @openloaf/widget-sdk build
RUN pnpm --filter @openloaf/db db:generate 2>&1 | tail -5 || true
RUN pnpm --filter web build 2>&1 | tail -20
# NO silent fallback: if the server doesn't build, the image must not ship.
# tsdown (the 'build' script) emits dist/index.mjs; build:prod (esbuild)
# emits dist/server.mjs. Either is fine — the entrypoint auto-detects.
RUN pnpm --filter server run build 2>&1 | tail -60; \
    if [ ! -f apps/server/dist/index.mjs ] && [ ! -f apps/server/dist/index.js ]; then \
      echo '=== tsdown produced no entry; trying build:prod (esbuild) ==='; \
      pnpm --filter server run build:prod 2>&1 | tail -120; \
    fi; \
    ls -la apps/server/dist/ | head -20; \
    test -f apps/server/dist/index.mjs -o -f apps/server/dist/index.js -o -f apps/server/dist/server.mjs

# ────────────────────────────────────────────────────────────────
# Aggressively prune everything not needed at runtime.
RUN set -e; \
    echo "=== BEFORE PRUNE ==="; du -sh node_modules; \
    # Nuke Electron - only apps/desktop uses it
    rm -rf node_modules/.pnpm/electron@*/node_modules/electron/dist 2>/dev/null || true; \
    rm -rf node_modules/electron 2>/dev/null || true; \
    rm -rf apps/desktop/node_modules 2>/dev/null || true; \
    # Nuke dev-only tooling
    for pat in 'typescript@*' 'eslint*' 'prettier@*' '@types+*' \
               'vitest@*' '@vitest*' 'jest*' '@jest*' 'mocha@*' \
               '@swc-core*' '@swc+core*' 'webpack@*' 'webpack-cli*' 'webpack-dev*' '@webpack*' \
               'rollup@*' '@rollup+*' 'esbuild@*' 'esbuild-*' 'terser@*' 'terser-*' \
               '@parcel+*' 'parcel@*' 'storybook@*' '@storybook*' \
               'playwright@*' 'chromium-bidi*' 'playwright-*'; do \
      find node_modules/.pnpm -maxdepth 1 -type d -name "$pat" -exec rm -rf {} + 2>/dev/null || true; \
    done; \
    # Playwright-core is needed by services/browser-stream, but not its bundled browsers
    find node_modules/.pnpm -type d -name 'browsers' -path '*playwright-core*' -exec rm -rf {} + 2>/dev/null || true; \
    # Big binary blobs we don't need at runtime
    find node_modules -type d \( -name 'test' -o -name 'tests' -o -name '__tests__' \
        -o -name 'examples' -o -name 'example' -o -name 'docs' -o -name 'doc' \
        -o -name 'benchmark' -o -name 'benchmarks' -o -name '.github' \
      \) -prune -exec rm -rf {} + 2>/dev/null || true; \
    find node_modules -type f \( -name '*.md' -o -name '*.markdown' -o -name '*.map' \
        -o -name 'CHANGELOG*' -o -name 'LICENSE*' -o -name '*.d.ts.map' \
        -o -name '*.tsbuildinfo' -o -name '.eslintrc*' -o -name '.prettierrc*' \
      \) -delete 2>/dev/null || true; \
    # Sharp includes prebuilt binaries for every arch; keep only linux-x64
    find node_modules/.pnpm -type d -path '*@img+sharp*' \
        ! -path '*sharp-linux-x64*' ! -path '*sharp-libvips-linux-x64*' \
        -mindepth 3 -maxdepth 4 -exec rm -rf {} + 2>/dev/null || true; \
    echo "=== AFTER PRUNE ==="; du -sh node_modules

# ────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libvips42 libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    libpango-1.0-0 libcairo2 fonts-liberation fonts-noto-color-emoji \
    tini procps ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/root/.openloaf/browsers \
    NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=23333 \
    OPENLOAF_WEB_MODE=1 \
    OPENLOAF_INSTALL_CHROMIUM_ON_BOOT=1

WORKDIR /app

COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/.npmrc ./
COPY --from=build /app/apps/web/out /app/apps/web/out
COPY --from=build /app/apps/web/package.json /app/apps/web/package.json
COPY --from=build /app/apps/server/dist /app/apps/server/dist
COPY --from=build /app/apps/server/package.json /app/apps/server/package.json
COPY --from=build /app/apps/server/scripts /app/apps/server/scripts
COPY --from=build /app/packages /app/packages
COPY --from=build /app/services /app/services
COPY --from=build /app/node_modules /app/node_modules

VOLUME ["/root/.openloaf"]
EXPOSE 8080

COPY --from=build /app/services/entrypoint/first-boot.sh /usr/local/bin/first-boot.sh
RUN chmod +x /usr/local/bin/first-boot.sh

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/first-boot.sh"]
